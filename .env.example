# ================================================================
# CyberAI Assessment Platform — Environment Configuration Template
# ================================================================
# Sao chép file này sang `.env` trước khi khởi chạy:
#     cp .env.example .env
#
# Đối với môi trường Production, bắt buộc:
# 1. Thay đổi JWT_SECRET bằng khóa ngẫu nhiên tối thiểu 32 ký tự:
#    python -c "import secrets; print(secrets.token_hex(32))"
# 2. Cấu hình CORS_ORIGINS theo đúng domain thực tế của hệ thống.
# 3. Đảm bảo Ollama local runtime hoặc Cloud API keys được thiết lập phù hợp.
# ================================================================

# ====== PHIÊN BẢN & METADATA HỆ THỐNG ======
CODE_VERSION=v1.2.0-verdict
GIT_COMMIT_SHA=c79037e

# ====== RUNTIME INFERENCE MODEL (Ollama Local GPU/CPU) ======
# Host URL của Ollama service (dùng host.docker.internal nếu Ollama chạy trên host Windows/Linux)
OLLAMA_URL=http://host.docker.internal:11434

# Mô hình phân vai tác tử (Multi-Agent Architecture)
MODEL_NAME=gemma4:latest
SECURITY_MODEL_NAME=gemma4:latest
EMBEDDING_MODEL_NAME=bge-m3

# Bộ ba model tiêu chuẩn phục vụ thẩm định kiểm toán
MODEL_1_EXTRACTOR=qwen2.5-coder:7b
MODEL_2_AUDITOR=gemma4:latest
MODEL_3_EMBEDDING=bge-m3
REQUIRED_MODEL_IDS=gemma4:latest,qwen2.5-coder:7b,bge-m3:latest

# Cấu hình suy luận
MAX_TOKENS=-1
DEBUG=true
THREADS=6
CONTEXT_SIZE=8192

# true  = Ưu tiên chạy Offline 100% On-Premise qua Ollama local (mặc định)
# false = Dự phòng tự động chuyển sang Cloud LLM khi Ollama không khả dụng
PREFER_LOCAL=true

# ====== CLOUD LLM API (Dự phòng tùy chọn khi Local AI quá tải) ======
CLOUD_LLM_API_URL=https://open-claude.com/v1
CLOUD_MODEL_NAME=gemini-2.0-flash
CLOUD_API_KEYS=your-cloud-api-key-here

# Google AI Studio (Gemini Free Tier API) — Tùy chọn dự phòng thứ hai
GOOGLE_AI_STUDIO_API_KEY=your-google-ai-studio-key-here
GOOGLE_AI_STUDIO_MODEL=gemini-2.5-flash
GOOGLE_AI_STUDIO_URL=https://generativelanguage.googleapis.com/v1beta

# ====== TÌM KIẾM WEB CỤC BỘ (SearXNG — Chỉ dùng cho Chatbot) ======
# Tuyệt đối không tham gia hoặc ảnh hưởng luồng Assessment tự động
SEARXNG_URL=http://searxng:8080

# ====== ĐƯỜNG DẪN DỮ LIỆU & LƯU TRỮ TRONG CONTAINER ======
ISO_DOCS_PATH=/data/iso_documents
VECTOR_STORE_PATH=/data/vector_store
DATA_PATH=/data
MODELS_PATH=/app/models

# ====== BACKEND & SECURITY ======
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost,http://localhost:80,http://localhost:3000,http://localhost:3081,http://127.0.0.1,http://127.0.0.1:80,http://127.0.0.1:3000,http://127.0.0.1:3081

# JWT Secret: Bắt buộc tối thiểu 32 ký tự ở Production
JWT_SECRET=change-me-in-production-must-be-at-least-32-chars
JWT_EXPIRE_MINUTES=60

# ====== GIỚI HẠN TẦN SUẤT (RATE LIMITING) ======
RATE_LIMIT_CHAT=15/minute
RATE_LIMIT_ASSESS=3/minute
RATE_LIMIT_BENCHMARK=5/minute

# ====== THỜI GIAN CHỜ (TIMEOUTS) ======
# Timeout suy luận mô hình local (giây) — 1800s (30 phút) cho các tác vụ lớn
INFERENCE_TIMEOUT=1800
CLOUD_TIMEOUT=600

# ====== CẤU HÌNH FRONTEND (Next.js) ======
NEXT_PUBLIC_API_URL=http://localhost:8000
API_URL=http://backend:8000
NEXT_TELEMETRY_DISABLED=1
NODE_ENV=development
