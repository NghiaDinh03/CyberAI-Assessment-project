# ================================================================
# CyberAI Assessment Platform — Comprehensive .gitignore
# ================================================================

# ====== Environment & Credentials (CRITICAL) ======
.env
.env.*
!.env.example
*.secret
secrets/
credentials.json
service-account*.json
*-credentials.json
gcp-key*.json
*.pem
*.key
*.crt
*.pfx
*.p12

# ====== AI Agent Context & Local Memory (CRITICAL: NEVER PUSH TO GIT) ======
.AI_CONTEXT/
.AI_CONTEXT/*
agent_memory/
agent_memory/*

# ====== Sensitive Enterprise Audit Data ======
*.docx
!docs/**/*.docx

# ====== Logs & Diagnostics ======
*.log
logs/
backend.log
ollama.log
_bk.log
_fe.log
backend/*.log
frontend-next/*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ====== Python ======
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
env/
ENV/
.venv/
*.egg-info/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
.tox/
.nox/
pip-log.txt
pip-delete-this-directory.txt

# ====== Node.js / Next.js Build Output ======
node_modules/
.next/
frontend-next/.next/
frontend-next/node_modules/
frontend-next/out/
frontend-next/build/
frontend-next/.turbo/
cyberai-frontend/
out/
.turbo/
.npm/
.yarn/
.pnp.*
*.tsbuildinfo
next-env.d.ts

# ====== Large Model Weights & Embeddings ======
models/
models/llm/weights/*
!models/llm/weights/.gitkeep
models/weights/*
!models/weights/.gitkeep
*.gguf
*.bin
*.safetensors
*.onnx
*.pt
*.pth
*.ckpt
*.h5
*.tflite

# ====== Runtime Databases & Stores ======
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm
data/auth/*
!data/auth/.gitkeep
data/sessions/*
!data/sessions/.gitkeep
data/assessments/*
!data/assessments/.gitkeep
data/uploads/*
!data/uploads/.gitkeep
data/summaries/*
!data/summaries/.gitkeep
data/exports/*
!data/exports/.gitkeep
data/evidence/*
!data/evidence/.gitkeep
data/vector_store/*.faiss
data/vector_store/chroma.sqlite3
data/vector_store/*/
data/articles_history.json
data/translations/*.json
backend/data/

# ====== Backups / Dumps / Archives ======
*.bak
*.backup
*.old
*.orig
*.tmp
*.swp
*.swo
*.dump
*.sql.gz
*.tar
*.tar.gz
*.tgz
*.zip
*.7z
*.rar
backup/
backups/

# ====== IDE & Operating System ======
.vscode/
!.vscode/settings.shared.json
.idea/
.vs/
*.sublime-project
*.sublime-workspace
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db
$RECYCLE.BIN/

# ====== Misc & Scratch ======
hash.txt
/context.md
TODO.local.md
NOTES.local.md
scratch/
tmp/
temp/
.cache/
.AI_CONTEXT/.claude/
.AI_CONTEXT/.roo/
.AI_CONTEXT/temp-karpathy-skills/
